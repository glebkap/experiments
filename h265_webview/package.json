{
    "name": "h265-hls-player",
    "version": "2.0.0",
    "description": "Веб-плеер для воспроизведения HLS плейлистов с H.265 на основе libde265 и hls.js",
    "main": "index.html",
    "scripts": {
        "start": "python3 cors_server.py --port 8080 --host 0.0.0.0",
        "serve": "serve -l 8000 --cors"
    },
    "keywords": [
        "hls",
        "libde265",
        "h265",
        "hevc",
        "m3u8",
        "video",
        "player",
        "streaming",
        "javascript",
        "html5",
        "adaptive-streaming"
    ],
    "author": "H.265 HLS Player Developer",
    "license": "MIT",
    "dependencies": {
        "hls.js": "^1.5.0",
        "goldvideo-player": "^1.0.2"
    },
    "devDependencies": {
        "serve": "^14.2.1"
    },
    "engines": {
        "node": ">=12.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yourusername/h265-hls-player.git"
    },
    "bugs": {
        "url": "https://github.com/yourusername/h265-hls-player/issues"
    },
    "homepage": "https://github.com/yourusername/h265-hls-player#readme"
}
