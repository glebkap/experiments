# Database Configuration
DATABASE_URL=postgresql+asyncpg://support:support@localhost:15432/support
DB_POOL_SIZE=10
DB_ECHO=false

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8100
CHROMADB_COLLECTION=support_issues

# ML Models Configuration
EMBEDDING_MODEL=intfloat/multilingual-e5-large
MAX_SEQ_LENGTH=512
DEVICE=cpu

# Pipeline Configuration
BATCH_SIZE=100
EMBEDDING_BATCH_SIZE=32
MAX_RETRIES=3
RETRY_DELAY=5

# Clustering Configuration
CLUSTERING_METHOD=hdbscan
# HDBSCAN: Minimum cluster size (3-5 for small datasets, 10-15 for large)
HDBSCAN_MIN_CLUSTER_SIZE=3
# HDBSCAN: Minimum samples (1-3, usually <= min_cluster_size)
HDBSCAN_MIN_SAMPLES=1
KMEANS_MAX_K=20

# API Configuration
API_TITLE=Analyzer Service
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8002

# Logging
LOG_LEVEL=INFO
