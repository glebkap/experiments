# =============================================================================
# КОНФИГУРАЦИЯ БАЗЫ ДАННЫХ
# =============================================================================
# URL подключения к PostgreSQL (драйвер asyncpg для асинхронной работы)
# Формат: postgresql+asyncpg://пользователь:пароль@хост:порт/база
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Размер пула соединений (количество постоянных подключений)
DB_POOL_SIZE=10

# Выводить SQL-запросы в консоль (полезно для отладки, true в dev окружении)
DB_ECHO=false

# =============================================================================
# КОНФИГУРАЦИЯ CHROMADB (Векторная база данных)
# =============================================================================
# Хост сервера ChromaDB
CHROMADB_HOST=localhost

# Порт сервера ChromaDB
CHROMADB_PORT=8100

# Название коллекции для хранения эмбедингов issues
CHROMADB_COLLECTION=support_issues

# =============================================================================
# КОНФИГУРАЦИЯ ML МОДЕЛЕЙ
# =============================================================================
# Название модели SentenceTransformer из HuggingFace
# Варианты: intfloat/multilingual-e5-large (рекомендуется), sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Примечание: Размерность эмбеддингов определяется автоматически из модели
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Максимальная длина последовательности для токенизации (более длинные тексты обрезаются)
MAX_SEQ_LENGTH=512

# Устройство для генерации эмбедингов
# Варианты:
#   - cpu: Использовать только CPU (медленно, работает везде)
#   - cuda: Использовать GPU NVIDIA с CUDA (быстро, требует PyTorch с поддержкой CUDA)
#   - mps: Использовать GPU Apple Silicon (M1/M2/M3, требует macOS)
#   - auto: Автоматически выбрать лучшее доступное устройство (cuda > mps > cpu)
# Примечание: Для GPU убедитесь, что установлен PyTorch с нужной поддержкой
DEVICE=cuda

# =============================================================================
# КОНФИГУРАЦИЯ PIPELINE
# =============================================================================
# Количество issues для выборки и обработки за один запуск pipeline
BATCH_SIZE=128

# Размер батча для генерации эмбедингов (меньше = меньше VRAM, медленнее; больше = больше VRAM, быстрее)
# Рекомендации: 32-64 для GPU с 8GB VRAM, 8-16 для 4GB, 4-8 для CPU
EMBEDDING_BATCH_SIZE=128

# Максимальное количество попыток повтора при ошибках
MAX_RETRIES=3

# Задержка между повторами в секундах
RETRY_DELAY=5

# =============================================================================
# КОНФИГУРАЦИЯ МЕНЕДЖЕРА ОБРАБОТКИ
# =============================================================================
# Автоматически запускать непрерывную фоновую обработку при старте сервиса
# Устанавливайте true для production, false для ручного/API запуска
AUTO_START_PROCESSING=true

# Интервал опроса базы данных на наличие новых необработанных issues (секунды)
POLL_INTERVAL_SECONDS=1.0

# ⚠️ ВНИМАНИЕ: Принудительная переобработка ВСЕХ issues
# При установке true будут:
#   1. Удалены ВСЕ записи из preprocessed_issues (PostgreSQL)
#   2. Удалены ВСЕ embeddings из ChromaDB коллекции
#   3. Все issues будут переобработаны заново с текущими настройками модели
#
# Используйте при:
#   - Смене модели трансформера (EMBEDDING_MODEL)
#   - Необходимости полной переиндексации
#
# ⚠️ ВАЖНО: Установите обратно в false после первого запуска!
REPROCESS_ALL=false

# =============================================================================
# КОНФИГУРАЦИЯ КЛАСТЕРИЗАЦИИ
# =============================================================================
# Алгоритм кластеризации: hdbscan (на основе плотности) или kmeans (на основе центроидов)
CLUSTERING_METHOD=hdbscan

# HDBSCAN: Минимальное количество образцов в кластере
HDBSCAN_MIN_CLUSTER_SIZE=5

# HDBSCAN: Минимальное количество образцов для базовых точек
HDBSCAN_MIN_SAMPLES=3

# KMeans: Максимальное количество кластеров для перебора (используется метод локтя для поиска оптимума)
KMEANS_MAX_K=20

# =============================================================================
# КОНФИГУРАЦИЯ API
# =============================================================================
# Название API сервиса (отображается в Swagger UI)
API_TITLE=Analyzer Service

# Версия API
API_VERSION=1.0.0

# Хост для привязки API сервера (0.0.0.0 = все интерфейсы)
API_HOST=0.0.0.0

# Порт для API сервера
API_PORT=8002

# =============================================================================
# КОНФИГУРАЦИЯ ЛОГИРОВАНИЯ
# =============================================================================
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Используйте DEBUG для разработки, INFO для production
LOG_LEVEL=DEBUG

# Логировать полный текст issue (заголовок + описание) в режиме DEBUG
# Установите false для вывода только превью (первые 100-200 символов)
DEBUG_LOG_ISSUE_CONTENT=true

# Максимальная длина содержимого issue для логирования (0 = без ограничений)
# Рекомендуется: 500-1000 для читаемости, 0 для полного текста
DEBUG_LOG_MAX_CONTENT_LENGTH=500

# Количество образцов issues для детального логирования на каждом этапе pipeline
# Установите 1-5 для отладки, 0 для отключения детального логирования
DEBUG_LOG_SAMPLE_SIZE=3
