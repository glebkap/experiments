# API Gateway Configuration

# Service URLs
PARSER_URL=http://parser:8001
ANALYZER_URL=http://analyzer:8002

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Timeouts (seconds)
REQUEST_TIMEOUT=30
HEALTH_CHECK_TIMEOUT=5

# Logging
LOG_LEVEL=INFO
